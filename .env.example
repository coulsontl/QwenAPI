# iFlow-Cli API Server 环境变量配置文件
# 复制此文件为 .env 并修改相应值

# 服务器配置
PORT=8000
HOST=0.0.0.0

# API 密码配置 (生产环境务必修改)
API_PASSWORD=qwen123

# 数据库配置
DATABASE_URL=data/tokens.db

# 时区配置 (默认: Asia/Shanghai)
TZ=Asia/Shanghai

# OAuth2 配置
OAUTH_BASE_URL=https://iflow.cn
OAUTH_CLIENT_ID=f0304373b74a44d2b584a3fb70ca9e56
OAUTH_SCOPE=openid profile email model.completion
OAUTH_CLIENT_SECRET=your_client_secret

# OAuth2 回调配置  
OAUTH2_CALLBACK_PORT=8000
OAUTH2_CALLBACK_HOST=localhost

# OAuth2 Token 交换配置
OAUTH2_TOKEN_ENDPOINT=https://iflow.cn/oauth/token
OAUTH_VERIFICATION_URI=https://iflow.cn/oauth
OAUTH2_AUTHORIZATION_HEADER=Basic your_base64_credentials


# API 配置
API_ENDPOINT=https://apis.iflow.cn/v1/chat/completions

# 调试配置
DEBUG=false
LOG_LEVEL=info

# Token刷新时间阈值（秒，默认2小时=7200秒）
# 当Token剩余有效期大于此值时，将跳过刷新
TOKEN_REFRESH_THRESHOLD_SECONDS=7200